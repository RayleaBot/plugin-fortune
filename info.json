{
  "id": "raylea.fortune",
  "name": "运势",
  "version": "0.3.0",
  "manifest_version": "3",
  "license": "MIT",
  "min_core_version": "0.4.0",
  "metadata": {
    "description": "每日运势抽取、统计与可视化管理",
    "author": "raylea",
    "repo": "https://github.com/RayleaBot/plugin-fortune",
    "keywords": ["fortune", "render", "vue"]
  },
  "concurrency": 4,
  "events": ["message.group", "message.private", "config.changed"],
  "permissions": {
    "message.send": true,
    "render.image": true
  },
  "default_config": {
    "trigger_commands": ["我的运势"],
    "stats_trigger_commands": ["运势统计"],
    "timezone": "Asia/Shanghai"
  },
  "commands": [
    {
      "id": "fortune",
      "name": "我的运势",
      "description": "查看今日运势",
      "usage": "/我的运势",
      "permission": "everyone",
      "trigger": {
        "type": "setting",
        "settings_key": "trigger_commands"
      }
    },
    {
      "id": "fortune-stats",
      "name": "运势统计",
      "description": "查看累计运势统计",
      "usage": "/运势统计",
      "permission": "everyone",
      "trigger": {
        "type": "setting",
        "settings_key": "stats_trigger_commands"
      }
    }
  ],
  "command_groups": [
    {
      "id": "fortune",
      "title": "运势查询",
      "commands": ["fortune", "fortune-stats"]
    }
  ],
  "help": {
    "title": "运势",
    "summary": "抽取每日运势并查看累计统计"
  },
  "management_ui": {
    "entry": "ui/index.html",
    "pages": [
      {
        "id": "settings",
        "label": "运势设置"
      }
    ]
  }
}
